{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "expert-systems-technology-site",

  "main": "./cloudflare/index.ts",

  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./frontend/dist/xpsys-site/browser",
    "binding": "ASSETS",

    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}